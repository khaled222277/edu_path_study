# Copy to .env and fill in. Never commit .env.

# "development" (default) or "production". In production the app refuses to
# start if JWT_SECRET / SESSION_SECRET are placeholders or under 32 characters,
# if they are equal, if the DATABASE_URL password is the default, or if
# COOKIE_SECURE is false.
ENVIRONMENT=development

# Postgres (also consumed by docker-compose.yml)
POSTGRES_USER=edupath
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=edupath_study

DATABASE_URL=postgresql://edupath:your_password_here@localhost:5432/edupath_study

# From https://console.cloud.google.com/apis/credentials
# The redirect URI below must be registered there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use two different values.
JWT_SECRET=
SESSION_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Session cookie. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_NAME=edupath_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origin of the React app: used for CORS and the post-login redirect.
FRONTEND_URL=http://localhost:5173

# Ollama request timeouts, in seconds (host comes from the standard OLLAMA_HOST env var).
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_INGEST_TIMEOUT_SECONDS=600

# Rate limits (slowapi, in-memory per process). auth is per IP; chat and quiz are per user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_QUIZ=5/minute

# Load the embedding model + reranker in a background thread at startup so the first
# chat message does not pay the ~15-30 s model load. Failure is logged, never fatal.
WARMUP_ON_STARTUP=true

# --- Tunable values (defaults shown; these are what the code used to hard-code) ---
# Ollama tags. Quiz and chat can differ.
CHAT_MODEL=llama3.1:8b
QUIZ_MODEL=llama3.1:8b
# Ingestion only (figure reading). Empty FALLBACK_VISION_MODEL disables the fallback.
VISION_MODEL=qwen3-vl:4b
FALLBACK_VISION_MODEL=qwen3-vl:8b

# Retrieval: CANDIDATE_K chunks are fetched from Chroma and reranked down to TOP_K.
# Startup fails unless 1 <= TOP_K <= CANDIDATE_K <= 200.
CANDIDATE_K=10
TOP_K=3
# If the reranker's best score is below this (0..1) its order is ignored and the
# vector order is kept. 0.1 sits well above its cross-lingual (Arabic) scores.
RERANK_MIN_CONFIDENCE=0.1

# Chunking, read by the ingestion CLI. CHANGING THESE ONLY AFFECTS LECTURES INGESTED
# AFTERWARDS: existing chunks keep their old boundaries until you re-ingest them.
# Requires 100 <= CHUNK_SIZE and 0 <= CHUNK_OVERLAP < CHUNK_SIZE.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Where Ollama lives. Empty = library default (http://localhost:11434, or the
# OLLAMA_HOST env var). From inside Docker use the host machine:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=

# How long Ollama keeps a model loaded after its last request (its own default is 5m,
# so the first student after a quiet spell waits for the model to load). A duration
# ("30m", "1h"), seconds, or -1 for forever. Used for chat, quiz and the startup
# warm-up alike so none of them shortens another's window.
OLLAMA_KEEP_ALIVE=30m

# Where the query embedder (bge-m3) runs: cpu, mps, cuda or cuda:N. If that accelerator
# is not available the app logs a warning and uses cpu instead of failing. Output is
# the same on any device, so changing it never needs a re-ingest.
EMBED_DEVICE=cpu

# --- Quiz generation (the measurements behind these are in bench_results/) ---
# Sampling temperature for quiz calls only (0-2). Keep above 0 so retries differ;
# 0.3 and 0.15 were measured and were not better than 0.5.
QUIZ_TEMPERATURE=0.5
# Model calls per chunk under the full rules, then (Arabic only) the relaxed rules.
# The relaxed phase tolerates Latin script in Arabic questions, so a lower strict
# budget can lower quality.
QUIZ_STRICT_ATTEMPTS=8
QUIZ_RELAXED_ATTEMPTS=4
# Attempts on a chunk before trying another one first. Chunks given up on are only
# revisited (with the rest of their budget) if the quiz is still short. 0 = off.
QUIZ_FIRST_PASS_ATTEMPTS=2
# Chunks generated at the same time. Only helps if Ollama itself serves requests in
# parallel (OLLAMA_NUM_PARALLEL=2 or 3 in Ollama's own environment); with the default
# of one request at a time extra callers just queue. See bench_results/README.md.
QUIZ_CONCURRENCY=1
