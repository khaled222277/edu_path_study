# Copy to .env and fill in. Never commit .env.

# "development" (default) or "production". In production the app refuses to
# start if JWT_SECRET / SESSION_SECRET are placeholders or under 32 characters,
# if they are equal, if the DATABASE_URL password is the default, or if
# COOKIE_SECURE is false.
ENVIRONMENT=development

# Postgres (also consumed by docker-compose.yml)
POSTGRES_USER=edupath
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=edupath_study

DATABASE_URL=postgresql://edupath:your_password_here@localhost:5432/edupath_study

# From https://console.cloud.google.com/apis/credentials
# The redirect URI below must be registered there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use two different values.
JWT_SECRET=
SESSION_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Session cookie. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_NAME=edupath_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Origin of the React app: used for CORS and the post-login redirect.
FRONTEND_URL=http://localhost:5173

# Ollama request timeouts, in seconds (host comes from the standard OLLAMA_HOST env var).
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_INGEST_TIMEOUT_SECONDS=600

# Rate limits (slowapi, in-memory per process). auth is per IP; chat and quiz are per user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_QUIZ=5/minute
