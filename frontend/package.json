{
  "name": "edupath-study-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-timeout=10000 \"src/**/*.test.js\"",
    "test:ui": "esbuild src/Quiz.jsx --bundle --format=esm --platform=node --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --outfile=tests-ui/.build/quiz.bundle.mjs --log-level=warning && esbuild src/Chat.jsx --bundle --format=esm --platform=node --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --outfile=tests-ui/.build/chat.bundle.mjs --log-level=warning && node --test --test-timeout=30000 \"tests-ui/*.ui.test.mjs\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "vite": "^6.0.7"
  }
}
